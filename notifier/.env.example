# ==============================================================================
# Notifier Service Configuration Blueprint (.env.example)
# ==============================================================================

# Node runtime environment: development, test, or production
NODE_ENV=development

# Port where health check endpoint listens
PORT=3001

# Kafka Broker address list
KAFKA_BROKERS=localhost:9092

# Consumer group identifier for auction notification events
KAFKA_GROUP_ID=notifier-group

# Kafka topic to consume bid and auction events from
KAFKA_TOPIC_AUCTION_EVENTS=auction-events

# SMTP mail relay host
SMTP_HOST=smtp.mailtrap.io

# SMTP relay port
SMTP_PORT=2525

# SMTP user account
SMTP_USER=your-smtp-username

# Path to mounted file containing SMTP secret password (in production)
SMTP_PASSWORD_FILE=/run/secrets/smtp-password
