# ==============================================================================
# Mini-AMP Environment Configuration Blueprint (.env.example)
# Copy to .env and fill in environment-specific credentials. Never commit .env to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Infrastructure: MySQL 8.0 Database
# ------------------------------------------------------------------------------
# Root password for administrative database operations and initialization
MYSQL_ROOT_PASSWORD=rootpassword

# Logical database name for the Mini-AMP application
MYSQL_DATABASE=mini_amp

# Dedicated non-root application user for MySQL connections
MYSQL_USER=amp_user

# Application user password (used in dev/docker environments)
MYSQL_PASSWORD=amppassword

# Host port mapped to container MySQL port 3306 (default: 3307 for local dev)
MYSQL_PORT=3307

# ------------------------------------------------------------------------------
# Infrastructure: Apache Kafka (KRaft mode) & Kafka UI
# ------------------------------------------------------------------------------
# External broker port accessible to host clients and microservices
KAFKA_PORT=9092

# Web dashboard port for inspecting Kafka topics, consumer groups, and partitions
KAFKA_UI_PORT=8081

# ------------------------------------------------------------------------------
# Spring Boot Application Runtime Configuration
# ------------------------------------------------------------------------------
# Active Spring configuration profile: 'dev', 'test', or 'prod'
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# Database Connection Pool (HikariCP / app.datasource)
# ------------------------------------------------------------------------------
# Maximum number of concurrent connections in the database connection pool (2-100)
APP_DATASOURCE_POOL_SIZE=10

# Maximum duration client will wait for a connection from pool before timeout
APP_DATASOURCE_CONNECTION_TIMEOUT=30s

# Maximum idle time before an unused connection is retired from the pool
APP_DATASOURCE_IDLE_TIMEOUT=10m

# ------------------------------------------------------------------------------
# Domain Registrar Integrations (Dynadot & GoDaddy)
# ------------------------------------------------------------------------------
# Active primary registrar provider implementation: 'dynadot' or 'godaddy'
REGISTRAR_DEFAULT_PROVIDER=dynadot

# API key for Dynadot REST integration (required in non-test profiles)
REGISTRAR_DYNADOT_API_KEY=your-dynadot-api-key-here

# Base URL endpoint for Dynadot API (must be valid HTTP/HTTPS URL)
REGISTRAR_DYNADOT_BASE_URL=https://api.dynadot.com/api3.json

# HTTP request timeout duration for Dynadot remote calls (e.g., 5s, 10s)
REGISTRAR_DYNADOT_TIMEOUT=5s

# API key for GoDaddy domain availability and auction integration
REGISTRAR_GODADDY_API_KEY=your-godaddy-api-key-here

# API secret associated with GoDaddy API key
REGISTRAR_GODADDY_API_SECRET=your-godaddy-api-secret-here

# Base URL endpoint for GoDaddy REST API
REGISTRAR_GODADDY_BASE_URL=https://api.godaddy.com